# Copy this file to ".env" for local work. NEVER commit the real .env.
# On Render, set these in the dashboard (Environment tab) instead. Values below are placeholders only.

# ── Server ───────────────────────────────────────────────
NODE_ENV=development            # use "production" on Render
PORT=4000                       # Render sets this itself
API_VERSION=v1
LOG_LEVEL=info                  # error | warn | info | debug

# ── Database (PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kaphor_db
# Direct (non-pooled) connection, used for migrations on Neon/Supabase. Optional elsewhere.
DIRECT_URL=

# ── Redis (optional locally, recommended in production) ──
REDIS_URL=redis://localhost:6379

# ── Auth: generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production needs at least 32 characters, and the two values must differ.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Web access (CORS) ────────────────────────────────────
# Comma separated list of web origins allowed to call the API. REQUIRED in production.
# Mobile apps do not need to be listed.
ALLOWED_ORIGINS=http://localhost:8081
# Public URL of the web app (used in email links)
FRONTEND_URL=http://localhost:8081
# Public URL of this API (used when building image links)
BACKEND_URL=http://localhost:4000

# ── Razorpay (India payments). All three together, or none ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=        # the secret you type when creating the webhook in the Razorpay dashboard

# ── Stripe (optional). Both together, or none ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI ───────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_MODEL=
YOUTUBE_API_KEY=                # only used by the enrich-t5 script
QWEN_GLIE_URL=                  # optional self-hosted model endpoint

# ── Image storage: use Cloudinary or S3 (or both) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# ── Push notifications (Firebase). All three together, or none ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Google sign-in (public client IDs, not secrets) ──
GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ── Admin account for scripts/upsert-admin.ts (run once by hand) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Optional tuning / script-only ──
PRISMA_QUERY_LOGS=false
SKIP_MIGRATIONS=false           # Docker only: set true to skip "prisma migrate deploy" at start
GOOGLE_API_KEY=                 # used by one script only
APIFY_TOKEN=                    # used by scraping scripts only
