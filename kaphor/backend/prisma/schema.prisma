generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════

enum UserRole {
  BUYER
  SELLER
  BOTH
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum UserTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  ELITE
}

enum GarmentState {
  LISTED
  INTEREST
  PURCHASE_INTENT
  SELL_INTENT
  OWNERSHIP
  DECLINE
  CIRCULATION
  REUSE_UPCYCLE_RECYCLE
  RESERVED_SALE
}

enum GarmentCondition {
  PRISTINE
  MINOR_WEAR
  UPCYCLE
  RECYCLE_ONLY
}

enum ListingType {
  SALE
  RENTAL
  ACCESSORY_SWAP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SwapStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum RentalStatus {
  REQUESTED
  APPROVED
  DECLINED
  RESERVED
  DISPATCHED
  ACTIVE
  RETURN_DISPATCHED
  RETURNED
  COMPLETED
  CANCELLED
  OVERDUE
}

enum EventType {
  VIEW
  SAVE
  WISHLIST
  ADD_TO_CART
  SEARCH
  FILTER_APPLY
  PURCHASE_INTENT
  PURCHASE
  RENTAL_INTENT
  RENTAL_CONFIRMED
  SWAP_INTENT
  SWAP_CONFIRMED
  SELL_INTENT
  RELIST
  REPOST
  LOG_WEAR
}

enum StyleAesthetic {
  MINIMALIST
  VINTAGE
  BOLD
  ETHNIC
  STREETWEAR
  LUXURY
}

enum PostType {
  OUTFIT
  TUTORIAL
  TRANSFORMATION
  CIRCULAR_STORY
}

enum UpcycleRequestStatus {
  PENDING_REVIEW
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

// ═══════════════════════════════════════════════
// USER
// ═══════════════════════════════════════════════

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  username          String          @unique
  passwordHash      String?
  googleId          String?         @unique
  displayName       String
  avatar            String?
  bio               String?
  location          String?
  role              UserRole        @default(BOTH)
  tier              UserTier        @default(BRONZE)
  isVerified        Boolean         @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationType  String?
  verificationDocUrl String?
  idNumberLast4     String?
  verificationSubmittedAt DateTime?
  isActive          Boolean         @default(true)
  styleVector       Float[]
  styleAesthetic    StyleAesthetic?
  preferenceProfile Json?
  onboardingDone    Boolean         @default(false)
  failedLoginAttempts Int           @default(0)
  lockUntil         DateTime?
  verificationToken String?
  verificationExpires DateTime?
  pushToken         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  garments          Garment[]
  ordersAsBuyer     Order[]         @relation("BuyerOrders")
  ordersAsSeller    Order[]         @relation("SellerOrders")
  swapsInitiated    Swap[]          @relation("SwapInitiator")
  swapsReceived     Swap[]          @relation("SwapReceiver")
  rentals           Rental[]
  behaviourEvents   BehaviourEvent[]
  behaviourSignals  BehaviourSignal[]
  posts             Post[]
  likes             Like[]
  comments          Comment[]
  followers         Follow[]        @relation("Following")
  following         Follow[]        @relation("Followers")
  notifications     Notification[]
  impactRecord      ImpactRecord?
  circSchedules     CirculationSchedule[]
  circularRequests  CircularRequest[]
  bespokeRequests   BespokeRequest[]
  refreshTokens     RefreshToken[]
  styleQuizAnswers  StyleQuizAnswer[]
  reviews           Review[]
  addresses         Address[]
  auditLogs         AuditLog[]
  orderMessages     OrderMessage[]
  peerReviewsWritten  PeerReview[] @relation("PeerReviewsWritten")
  peerReviewsReceived PeerReview[] @relation("PeerReviewsReceived")
  cartItems           CartItem[]
  conversations       ChatConversation[]
  conversationsAsP1   Conversation[]  @relation("Participant1Conversations")
  conversationsAsP2   Conversation[]  @relation("Participant2Conversations")
  directMessagesSent  DirectMessage[] @relation("DirectMessagesSent")
  directMessagesRecv  DirectMessage[] @relation("DirectMessagesReceived")
  reportsSubmitted    UserReport[]    @relation("ReportsSubmitted")
  reportsReceived     UserReport[]    @relation("ReportsReceived")
  upcycleRequests     UpcycleRequest[]
  glieCorrections     GLIECorrection[]

  @@map("users")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  fullName  String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  country   String   @default("India")
  pincode  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token      String   @unique
  userId     String
  expiresAt  DateTime
  replacedBy String?
  isRevoked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════
// GARMENT
// ═══════════════════════════════════════════════

model Garment {
  id               String          @id @default(uuid())
  sellerId         String
  title            String
  description      String
  brand            String
  category         String
  subCategory      String?
  size             String
  color            String[]
  material         String[]
  fabric           String?
  style            String?
  sleeve           String?
  shape            String?
  pattern          String?
  weight           String?
  condition        GarmentCondition
  images           String[]
  tags             String[]
  styleTags        String[]
  garmentVector    Float[]
  lifecycleState   GarmentState    @default(LISTED)
  listingType      ListingType     @default(SALE)
  reservedOrderId  String?
  price            Int?
  rentalPriceDay   Int?
  rentalPriceWeek  Int?
  recyclableFiber  Float?
  popularityScore  Float           @default(0)
  diversityScore   Float           @default(0)
  viewCount        Int             @default(0)
  isActive         Boolean         @default(true)
  materialId       String?
  reuseCount       Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  seller           User            @relation(fields: [sellerId], references: [id])
  orderItems       OrderItem[]
  behaviourEvents  BehaviourEvent[]
  behaviourSignals BehaviourSignal[]
  swapsOffered     Swap[]          @relation("SwapOffered")
  swapsWanted      Swap[]          @relation("SwapWanted")
  rentals          Rental[]
  circSchedules    CirculationSchedule[]
  circularRequests CircularRequest[]
  reviews          Review[]
  cartItems        CartItem[]
  conversations    ChatConversation[]
  inquiries        Conversation[]
  upcycleRequests  UpcycleRequest[]

  @@index([sellerId])
  @@index([isActive, createdAt])
  @@index([category, isActive])
  @@index([listingType, isActive])
  @@index([reservedOrderId])
  @@map("garments")
}

// ═══════════════════════════════════════════════
// BEHAVIOUR ENGINE
// ═══════════════════════════════════════════════

model BehaviourEvent {
  id         String     @id @default(uuid())
  userId     String
  garmentId  String?
  eventType  EventType
  sessionId  String?
  metadata   Json?
  createdAt  DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  garment    Garment?   @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@index([userId, garmentId])
  @@index([userId, createdAt])
  @@map("behaviour_events")
}

model BehaviourSignal {
  id               String   @id @default(uuid())
  userId           String
  garmentId        String
  interestScore    Float    @default(0)
  recentEventCount Int      @default(0)
  engagementRate   Float    @default(0)
  interactionDecay Float    @default(0)
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  garment          Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([userId, garmentId])
  @@map("behaviour_signals")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  garmentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  garment   Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([userId, garmentId])
  @@map("cart_items")
}

model CirculationSchedule {
  id              String   @id @default(uuid())
  garmentId       String
  userId          String
  cooldownStart   DateTime
  cooldownEnd     DateTime
  saturationScore Float
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  garment         Garment  @relation(fields: [garmentId], references: [id])
  user            User     @relation(fields: [userId], references: [id])

  @@map("circulation_schedules")
}

// ═══════════════════════════════════════════════
// ORDERS
// ═══════════════════════════════════════════════

model Order {
  id              String      @id @default(uuid())
  buyerId         String
  sellerId        String
  status          OrderStatus @default(PENDING)
  totalAmount     Int
  currency        String      @default("USD")
  stripePaymentId String?
  razorpayOrderId String?
  razorpayPaymentId String?
  shippingAddress Json?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyer           User        @relation("BuyerOrders",  fields: [buyerId],  references: [id])
  seller          User        @relation("SellerOrders", fields: [sellerId], references: [id])
  items           OrderItem[]
  messages        OrderMessage[]
  peerReview      PeerReview?

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  garmentId String
  price     Int
  quantity  Int     @default(1)

  order     Order   @relation(fields: [orderId],   references: [id], onDelete: Cascade)
  garment   Garment @relation(fields: [garmentId], references: [id])

  @@map("order_items")
}

// ═══════════════════════════════════════════════
// ACCESSORY SWAP
// ═══════════════════════════════════════════════

model Swap {
  id              String     @id @default(uuid())
  initiatorId     String
  receiverId      String
  garmentOffered  String
  garmentWanted   String
  status          SwapStatus @default(REQUESTED)
  message         String?
  metadata        Json?
  completedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  initiator       User       @relation("SwapInitiator", fields: [initiatorId], references: [id])
  receiver        User       @relation("SwapReceiver",  fields: [receiverId],  references: [id])
  offeredGarment  Garment    @relation("SwapOffered", fields: [garmentOffered], references: [id])
  wantedGarment   Garment    @relation("SwapWanted", fields: [garmentWanted], references: [id])

  @@map("swaps")
}

// ═══════════════════════════════════════════════
// RENTAL
// ═══════════════════════════════════════════════

model Rental {
  id                 String       @id @default(uuid())
  garmentId          String
  renterId           String
  startDate          DateTime
  endDate            DateTime
  totalPrice         Int
  status             RentalStatus @default(REQUESTED)
  stripeId           String?
  message            String?
  shippingAddress    Json?
  trackingNumber     String?
  carrier            String?
  returnTracking     String?
  returnCarrier      String?
  approvedAt         DateTime?
  paidAt             DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  returnDispatchedAt DateTime?
  returnDeliveredAt  DateTime?
  depositRefundedAt  DateTime?
  declineReason      String?
  trackingHistory    Json?
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  garment            Garment      @relation(fields: [garmentId], references: [id])
  renter             User         @relation(fields: [renterId],  references: [id])

  @@map("rentals")
}

// ═══════════════════════════════════════════════
// SOCIAL
// ═══════════════════════════════════════════════

model Post {
  id          String   @id @default(uuid())
  userId      String
  type        PostType
  caption     String?
  images      String[]
  garmentIds  String[]
  tags        String[]
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       Like[]
  comments    Comment[]

  @@map("posts")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("Followers",  fields: [followerId],  references: [id], onDelete: Cascade)
  following   User     @relation("Following",  fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

// ═══════════════════════════════════════════════
// IMPACT TRACKING
// ═══════════════════════════════════════════════

model ImpactRecord {
  id              String   @id @default(uuid())
  userId          String   @unique
  carbonSavedKg   Float    @default(0)
  waterSavedL     Float    @default(0)
  itemsCirculated Int      @default(0)
  itemsUpcycled   Int      @default(0)
  itemsRecycled   Int      @default(0)
  wasteSavedG     Float    @default(0)
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("impact_records")
}

// ═══════════════════════════════════════════════
// CIRCULAR SERVICE
// ═══════════════════════════════════════════════

model CircularRequest {
  id              String   @id @default(uuid())
  userId          String
  garmentId       String
  address         String
  preferredSlot   String
  partnerId       String
  status          String   @default("SCHEDULED")
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
  garment         Garment  @relation(fields: [garmentId], references: [id])

  @@map("circular_requests")
}

model BespokeRequest {
  id           String   @id @default(uuid())
  userId       String
  garmentId    String?
  description  String
  contactEmail String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id])

  @@map("bespoke_requests")
}

// ═══════════════════════════════════════════════
// STYLE QUIZ
// ═══════════════════════════════════════════════

model StyleQuizAnswer {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  answer     String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("style_quiz_answers")
}

// ═══════════════════════════════════════════════
// REVIEWS
// ═══════════════════════════════════════════════

model Review {
  id         String   @id @default(uuid())
  userId     String
  garmentId  String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  garment    Garment  @relation(fields: [garmentId], references: [id])

  @@unique([userId, garmentId])
  @@map("reviews")
}

/// Buyer rates seller after order is delivered (peer verification).
model PeerReview {
  id         String   @id @default(uuid())
  orderId    String   @unique
  reviewerId String
  sellerId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer User  @relation("PeerReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  seller   User  @relation("PeerReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("peer_reviews")
}

/// In-app messages between buyer and seller for an order (post-payment coordination).
model OrderMessage {
  id        String    @id @default(uuid())
  orderId   String
  senderId  String
  body      String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_messages")
}

// ═══════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ChatConversation {
  id        String   @id @default(uuid())
  userId    String
  garmentId String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  garment   Garment? @relation(fields: [garmentId], references: [id], onDelete: SetNull)
  messages  ChatMessage[]

  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String // "user" or "assistant"
  content        String
  createdAt      DateTime @default(now())

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ═══════════════════════════════════════════════
// UPCYCLING
// ═══════════════════════════════════════════════

model UpcycleRequest {
  id              String               @id @default(uuid())
  userId          String
  garmentId       String
  suggestionIndex Int?
  customIdea      String?
  notes           String?
  images          String[]
  status          UpcycleRequestStatus @default(PENDING_REVIEW)
  estimatedCost   Float?
  estimatedDays   Int?
  adminNotes      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User                 @relation(fields: [userId], references: [id])
  garment         Garment              @relation(fields: [garmentId], references: [id])

  @@map("upcycle_requests")
}

// ═══════════════════════════════════════════════
// STUDIO — Tutorials & Transformations
// ═══════════════════════════════════════════════

model Tutorial {
  id          String   @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  duration    String?
  difficulty  String?
  tags        String[]
  videoUrl    String?
  type        String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tutorials")
}

model Transformation {
  id              String   @id @default(uuid())
  beforeImage     String?
  afterImage      String?
  description     String?
  creatorUsername String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("transformations")
}

model MaterialImpact {
  id            String   @id @default(uuid())
  name          String   @unique
  category      String
  co2Kg         Float
  waterL        Float
  avgWeightG    Float
  reuseFactor   Float
  sourceRef     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("material_impact_db")
}

// ═══════════════════════════════════════════════
// DIRECT USER-TO-USER MESSAGING & CONVERSATIONS
// ═══════════════════════════════════════════════

model Conversation {
  id              String          @id @default(uuid())
  participant1Id  String
  participant2Id  String
  garmentId       String?
  lastMessageText String?
  lastMessageAt   DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  participant1    User            @relation("Participant1Conversations", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2    User            @relation("Participant2Conversations", fields: [participant2Id], references: [id], onDelete: Cascade)
  garment         Garment?        @relation(fields: [garmentId], references: [id], onDelete: SetNull)
  messages        DirectMessage[]

  @@unique([participant1Id, participant2Id, garmentId])
  @@index([participant1Id, lastMessageAt])
  @@index([participant2Id, lastMessageAt])
  @@map("conversations")
}

model DirectMessage {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  recipientId    String
  content        String
  imageUrl       String?
  isFlagged      Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("DirectMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User         @relation("DirectMessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([recipientId, readAt])
  @@map("direct_messages")
}

// ═══════════════════════════════════════════════
// TRUST & SAFETY: USER REPORTS
// ═══════════════════════════════════════════════

model UserReport {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         String
  details        String?
  status         String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt      DateTime @default(now())

  reporter       User     @relation("ReportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User     @relation("ReportsReceived", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reportedUserId])
  @@map("user_reports")
}

// ═══════════════════════════════════════════════
// GLIE — CONDITION ASSESSMENT CORRECTIONS
// ═══════════════════════════════════════════════

model GLIECorrection {
  id                      String   @id @default(uuid())
  assessmentId            String?  // optional: links to the frontend-generated assessment UUID
  userId                  String?  // null if not logged in
  garmentCategory         String
  fiberType               String
  originalConditionScore  Float
  correctedConditionScore Float
  originalRouting         String   // RESELL / UPCYCLE / RECYCLE
  correctedRouting        String
  originalPriceInr        Int?
  notes                   String?
  createdAt               DateTime @default(now())

  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([garmentCategory, fiberType])
  @@map("glie_corrections")
}
