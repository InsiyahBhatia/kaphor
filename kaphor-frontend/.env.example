EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
# Web client ID (OAuth 2.0 "Web application") — required for idToken on native Google Sign-In
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android physical device: localhost does not reach your PC. Either set your LAN IP explicitly, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000/api/v1
# or rely on dev auto-rewrite in src/services/api.ts when using localhost.
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# Razorpay Key ID (used by the Expo Razorpay UI)
EXPO_PUBLIC_RAZORPAY_KEY_ID=
