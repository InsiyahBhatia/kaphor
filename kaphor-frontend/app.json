{
  "expo": {
    "name": "Kaphor",
    "slug": "kaphor",
    "version": "1.0.0",
    "scheme": "kaphor",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.kaphor.app",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.kaphor.app",
      "googleServicesFile": "./google-services.json"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F0E8"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "com.kaphor.app",
          "enableGooglePay": true
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3aeb7c93-08b6-4700-b8aa-d55744986915"
      }
    }
  }
}
