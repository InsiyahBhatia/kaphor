{
  "expo": {
    "name": "Kaphor",
    "slug": "kaphor",
    "version": "1.0.0",
    "scheme": "kaphor",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.kaphor.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.kaphor.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F0E8"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F5F0E8"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1091661686962-8v9tqlipbm6jf3gom0bg4q8rj4q41m7v"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you list garments and upload condition evidence.",
          "cameraPermission": "The app accesses your camera to take photos of garments for verification."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3aeb7c93-08b6-4700-b8aa-d55744986915"
      }
    }
  }
}
